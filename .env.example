# ==============================================================================
# SISTEMA LOCAR - MONITORAMENTO DE ROTAS & HEATMAP (sitemaLCv1)
# ==============================================================================
# Configure abaixo no ambiente local (.env) ou na aba "Variables" do Railway.

# ------------------------------------------------------------------------------
# 1. CREDENCIAIS DA API OFICIAL INLOG (Inlog.Integration.Coleta.Api)
# ------------------------------------------------------------------------------
INLOG_BASE_URL=https://locar.inlog.com.br/IntegrationColeta
INLOG_TOKEN_URL=https://locar.inlog.com.br/autenticacao-services/connect/token
INLOG_CLIENT_ID=Locar.Client.Api.Coleta
INLOG_CLIENT_SECRET=SUA_CHAVE_INLOG_AQUI
INLOG_SERVER_ID=Inlog.Integration.Coleta.Api

# ------------------------------------------------------------------------------
# 2. SEGURANÇA DO PAINEL CENTRAL E LINKS ASSINADOS (/v/<token>)
# ------------------------------------------------------------------------------
# Chave HMAC usada para assinar tokens de link exclusivo (use 32+ caracteres aleatórios no Railway)
SECRET_KEY=gere-uma-chave-secreta-forte-aqui-com-32-caracteres

# Senha exigida em /login para acessar ou desbloquear o Painel Central
ADMIN_PASSWORD=filialsaopaulo01

# true = exige login até na tela inicial (/) na internet (Recomendado no Railway!)
# false = libera painel central localmente, mas bloqueia se o navegador abrir /v/<token>
REQUIRE_ADMIN_LOGIN=true

# ------------------------------------------------------------------------------
# 3. BANCO DE DADOS PERSISTENTE (POSTGRESQL OU SQLITE)
# ------------------------------------------------------------------------------
# No Railway com PostgreSQL, basta vincular o serviço Postgres (DATABASE_URL):
# DATABASE_URL=postgresql://postgres:senha@host:5432/railway
#
# Caso use SQLite em Volume montado em /data, defina:
DATABASE_PATH=/data/locar.db
# (Localmente, se ambos estiverem vazios, usa sitemaLCv1/locar.db)

# ------------------------------------------------------------------------------
# 4. SERVIDOR WEB E MALHAS
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
MALHA_TIPO=TRANSITAVEIS

# ------------------------------------------------------------------------------
# 5. REGRAS OPERACIONAIS DE AUDITORIA LOCAR
# ------------------------------------------------------------------------------
GPS_BUFFER_METROS=20.0
VELOCIDADE_MIN_COLETA=2.0
VELOCIDADE_MAX_COLETA=25.0
DWELL_TIME_MIN_SEGUNDOS=180
